<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>EquipmentLibraryV2_Avalonia</RootNamespace>
    <AssemblyTitle>EquipmentLibraryV2_Avalonia</AssemblyTitle>
    <AssemblyName>EquipmentLibraryV2_Avalonia</AssemblyName>
    <ApplicationIcon>Assets\Logo\logo.ico</ApplicationIcon>
    <Version>1.9.0-pre</Version>
    <Title>Equipment Library v2</Title>
    <Authors>Michael</Authors>
    <Description>Cross-platform desktop application for equipment accounting and measurement
register management.</Description>
    <Copyright>Copyright © 2026 Michael</Copyright>
    <PackageProjectUrl>https://github.com/MishaelBoss/EquipmentLibraryV2-Avalonia</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/MishaelBoss/EquipmentLibraryV2-Avalonia/blob/main/LICENSE</PackageLicenseUrl>
    <PackageTags>avalonia csharp dotnet postgresql equipment-management </PackageTags>
    <Company>Michael Development</Company>
    <Product>Equipment Library v2</Product>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <FileVersion>1.9.0.0</FileVersion>
    <NeutralLanguage>ru</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\logo\logo.ico" />
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="dbup" Version="5.0.41" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="Humanizer.Core.ru" Version="3.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Components\AddOrEditUserUserControlView.axaml.cs">
      <DependentUpon>AddOrEditUserUserControlView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
