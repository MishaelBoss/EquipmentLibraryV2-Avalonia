<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.modernBorder">
        <Setter Property="Background" Value="{DynamicResource BrushSurface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #60000000"/>
    </Style>

    <Style Selector="TextBlock.modernFieldLabel">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
        <Setter Property="Margin" Value="4,0,0,6"/>
    </Style>

    <Style Selector="TextBox.modernInput">
        <Setter Property="Background" Value="{DynamicResource BrushSurface3}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="TextBox.modernInput:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#555"/>
        <Setter Property="Background" Value="#404040"/>
    </Style>
    
    <Style Selector="TextBox.modernInput:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#28A745"/>
        <Setter Property="Background" Value="#3A3A3A"/>
    </Style>

    <Style Selector="TextBox.modernInput /template/ Border#PART_BorderElement">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ComboBox.modernSelect">
        <Setter Property="Background" Value="#3A3A3A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#444"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style Selector="ComboBox.modernSelect ComboBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <Style Selector="ComboBox.modernSelect:pointerover /template/ Border#Layer_1">
        <Setter Property="Background" Value="{DynamicResource BrushSurface3}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderDefault}"/>
    </Style>

    <Style Selector="ComboBox.modernSelect /template/ Border#Layer_1">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.modernPrimary">
        <Setter Property="Background" Value="{DynamicResource BrushAccentGreen}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="Button.modernPrimary TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
    
    <Style Selector="Button.modernPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentGreenHover}"/>
    </Style>

    <Style Selector="Button.modernPrimary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.modernClosed">
        <Setter Property="Background" Value="{DynamicResource BrushSurface1}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.modernClosed Image.normal">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.modernClosed Image.hover">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="Button.modernClosed:pointerover Image.normal">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.modernClosed:pointerover Image.hover">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    
    <Style Selector="Button.modernClosed:pointerover">
        <Setter Property="Cursor" Value="hand"/>
    </Style>
    
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSurface1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSurface3}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    
    <Style Selector="Button.modernFlyoutItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
    </Style>
    
    <Style Selector="Button.modernFlyoutItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="#888888" />
    </Style>
    
    <Style Selector="Button.modernFlyoutItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3A3A3A"/>
    </Style>
    
    <Style Selector="Button.modernFlyoutItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2E2E2E"/>
    </Style>

    <Style Selector="Button.modernFlyoutItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
</Styles>
