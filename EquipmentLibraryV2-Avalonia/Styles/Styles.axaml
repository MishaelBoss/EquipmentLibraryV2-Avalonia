<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
        <Style Selector="TextBox.TB1">
                <Setter Property="PlaceholderForeground" Value="#80FFFFFF"/>
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#444"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    
        <Style Selector="TextBox.TB1:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#555"/>
                <Setter Property="Background" Value="#404040"/>
        </Style>
    
        <Style Selector="TextBox.TB1:focus /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#28A745"/>
                <Setter Property="Background" Value="#3A3A3A"/>
                <Setter Property="BoxShadow" Value="0 0 0 3 #3028A745"/>
        </Style>
</Styles>
