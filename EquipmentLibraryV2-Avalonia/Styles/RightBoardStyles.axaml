<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style Selector="Button.BTN">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.BTN /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>
    
    <Style Selector="Button.BTN:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="TextBlock.Foreground" Value="Yellow"/> 
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Width" Value="185"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Foreground" Value="#9E9EB0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
                        
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A1A1C"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
                        
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#1E3A5F"/>
        <Setter Property="BorderBrush" Value="#345B8C"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
</Styles>
