<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels"
        x:DataType="vm:CreateAdminDialogWindowViewModel"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="400"
        x:Class="EquipmentLibraryV2_Avalonia.Views.CreateAdminDialogWindow"
        Width="460" Height="390"
        MinWidth="460" MinHeight="390"
        MaxWidth="840" MaxHeight="600"
        CanResize="true"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#1E1E24"
        Title="Создание администратора">
    
    <Window.Styles>
        <StyleInclude Source="/Styles/Styles.axaml"/>
    </Window.Styles>

    <Border BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
              Margin="24, 28, 24, 20">
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="Создание администратора"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <TextBlock Text="База данных создана. Задайте учётную запись администратора для входа:"
                           Foreground="#9E9EB0"
                           FontSize="13"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="Логин" Foreground="#9E9EB0" FontSize="13"/>
                <TextBox Text="{Binding Login}" PlaceholderText="Логин"
                         Classes="TB1"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="Пароль" Foreground="#9E9EB0" FontSize="13"/>
                <TextBox Text="{Binding Password}" PlaceholderText="Минимум 6 символов"
                         PasswordChar="●"
                         Classes="TB1"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="Подтверждение пароля" Foreground="#9E9EB0" FontSize="13"/>
                <TextBox Text="{Binding ConfirmPassword}" PlaceholderText="Повторите пароль"
                         PasswordChar="●"
                         Classes="TB1"/>
            </StackPanel>

            <TextBlock Grid.Row="4"
                       Text="{Binding StatusText}"
                       Foreground="#E74C3C"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="Закрыть"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Background="Transparent"
                        Foreground="#9E9EB0"
                        BorderBrush="#3D3D45"
                        BorderThickness="1"
                        Padding="24,8"
                        CornerRadius="6">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#2D2D35"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Content="Создать"
                        Command="{Binding CreateCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        IsEnabled="{Binding !IsBusy}"
                        Background="#28A745"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="24,8"
                        CornerRadius="6">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#218838"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>