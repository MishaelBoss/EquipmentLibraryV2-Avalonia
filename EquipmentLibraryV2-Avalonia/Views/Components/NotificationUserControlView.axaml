<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels.Components"
             x:DataType="vm:NotificationUserControlViewModel"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DesignHeight="570"
             x:Class="EquipmentLibraryV2_Avalonia.Views.Components.NotificationUserControlView">

    <Design.DataContext>
        <vm:NotificationUserControlViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <StyleInclude Source="/Styles/Styles.axaml"/>
        <StyleInclude Source="/Styles/ConnectionErrorStyles.axaml"/>
        <StyleInclude Source="/Styles/ModernStyles.axaml"/>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*">
        <Border Background="Black">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Height="64"
                        Padding="10,0,10,10">

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Уведомления"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="White"
                                       VerticalAlignment="Center" />

                            <Border Background="#2E3038"
                                    CornerRadius="9"
                                    MinWidth="18"
                                    Height="18"
                                    Padding="5,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasMessages}">

                                <TextBlock Text="{Binding Messages.Count}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#C6CAD3"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            
                            <Button Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Top"
                                    Height="25"
                                    Width="25"
                                    Padding="0"
                                    Classes="WB2"
                                    ToolTip.Tip="Опции">
                                
                                <Image Source="{SvgImage /Assets/action/more.svg}"
                                       Width="16"
                                       Height="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Spacing="2" MinWidth="160">
                                            <Button Classes="modernFlyoutItem"
                                                    IsEnabled="{Binding HasMessages}"
                                                    Command="{Binding ClearAllCommand}"
                                                    ToolTip.Tip="Очистить все">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Image Source="{SvgImage /Assets/delete_dark.svg}"
                                                           Width="16"
                                                           Height="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                    
                                                    <TextBlock Text="Очистить все" FontSize="13"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Background="Transparent"
                                    Command="{Binding HideCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Top"
                                    Height="25"
                                    Width="25"
                                    Padding="0"
                                    Classes="WB2"
                                    ToolTip.Tip="Скрыть">

                                <Image Source="{SvgImage /Assets/hide.svg}"
                                       Width="20"
                                       Height="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding HasMessages}">

                    <ItemsControl ItemsSource="{Binding Messages}"
                                  Margin="8,6,8,10">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#15161A"
                                        BorderBrush="#2A2C33"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,7">

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          RowDefinitions="Auto,Auto">

                                        <Svg Grid.RowSpan="2"
                                             Grid.Column="0"
                                             Path="{Binding IconPath}"
                                             Width="16"
                                             Height="16"
                                             Stretch="Uniform"
                                             VerticalAlignment="Top"
                                             Margin="0,2,8,0"
                                             IsHitTestVisible="False" />

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding DisplayTitle}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,6,0" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding Object}"
                                                   Foreground="#B9BDC7"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="48"
                                                   Margin="0,3,6,0" />

                                        <Button Grid.Row="0"
                                                Grid.Column="2"
                                                Classes="CloseBtn"
                                                Command="{Binding CloseCommand}"
                                                VerticalAlignment="Top"
                                                HorizontalAlignment="Right"
                                                ToolTip.Tip="Закрыть">

                                            <Grid IsHitTestVisible="False">
                                                <Image Classes="DarkIcon"
                                                       Source="{SvgImage /Assets/closeSmall.svg}"
                                                       Width="16"
                                                       Height="16" />
                                                <Image Classes="LightIcon"
                                                       Source="{SvgImage /Assets/closeSmallHovered.svg}"
                                                       Width="16"
                                                       Height="16" />
                                            </Grid>
                                        </Button>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   Text="{Binding TimeText}"
                                                   Foreground="#6E7280"
                                                   FontSize="10"
                                                   VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Right"
                                                   Margin="6,0,0,0" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            IsVisible="{Binding IsEmpty}">

                    <TextBlock Text="Нет уведомлений"
                               Foreground="#6E7280"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
