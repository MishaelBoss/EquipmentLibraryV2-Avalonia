<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:EquipmentLibraryV2_Avalonia.Converters"
             xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels.Components"
             x:DataType="vm:MessageUserControlViewModel"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="50"
             MinHeight="50" MaxWidth="450" 
             Background="Transparent"
             x:Class="EquipmentLibraryV2_Avalonia.Views.Components.MessageUserControlView">
    
    <UserControl.Styles>
        <StyleInclude Source="/Styles/ConnectionErrorStyles.axaml" />
    </UserControl.Styles>
    
    <Design.DataContext>
        <vm:MessageUserControlViewModel/>
    </Design.DataContext>
    
    <UserControl.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
    </UserControl.Resources>
    
    <Border
        Background="#1E1E24"
        BorderBrush="#2D2D35"
        BorderThickness="1"
        CornerRadius="8"
        Padding="10"
        Opacity="{Binding IsClosing, Converter={StaticResource BoolToOpacityConverter}}">

        <Border.Transitions>
            <Transitions>
                <DoubleTransition
                    Property="Opacity"
                    Duration="0:0:0.3" />
            </Transitions>
        </Border.Transitions>

        <Grid ColumnDefinitions="Auto,*,Auto">
            <Svg
                Grid.Column="0"
                Path="{Binding IconPath}"
                Width="21"
                Height="21"
                Stretch="Uniform"
                VerticalAlignment="Top"
                Margin="0,2,10,0"
                IsHitTestVisible="False" />

            <StackPanel
                Grid.Column="1"
                Spacing="4"
                Margin="0,2,10,0">

                <TextBlock
                    Text="{Binding DisplayTitle}"
                    Foreground="White"
                    FontSize="13"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />

                <TextBlock
                    Text="{Binding Object}"
                    Foreground="#BFC3CB"
                    FontSize="12"
                    TextWrapping="Wrap" />

            </StackPanel>

            <Button
                Grid.Column="2"
                Classes="CloseBtn"
                Command="{Binding CloseCommand}"
                VerticalAlignment="Top"
                ToolTip.Tip="Закрыть">

                <Grid IsHitTestVisible="False">
                    <Image
                        Classes="DarkIcon"
                        Source="{SvgImage /Assets/closeSmall.svg}"
                        Width="21"
                        Height="21" />

                    <Image
                        Classes="LightIcon"
                        Source="{SvgImage /Assets/closeSmallHovered.svg}"
                        Width="21"
                        Height="21" />
                </Grid>

            </Button>
        </Grid>
    </Border>
</UserControl>
