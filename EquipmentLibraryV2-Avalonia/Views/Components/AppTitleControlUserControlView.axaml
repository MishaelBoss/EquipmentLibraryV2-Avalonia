<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EquipmentLibraryV2_Avalonia.Views.Components.AppTitleControlUserControlView">
    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center" 
                Margin="{OnPlatform Windows='16,0,0,0', macOS=0, Linux=0}" 
                Spacing="5"
                HorizontalAlignment="{OnPlatform Windows=Left, macOS=Center, Linux=Center}">
        <Image Source="/Assets/logo/logo.ico" 
               Width="18" Height="18" 
               IsVisible="{OnPlatform True, macOS=False, Linux=False, Windows=True}"/>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontWeight="SemiBold"
                   Foreground="#CED0D6"
                   IsHitTestVisible="False"/>
    </StackPanel>
</UserControl>
