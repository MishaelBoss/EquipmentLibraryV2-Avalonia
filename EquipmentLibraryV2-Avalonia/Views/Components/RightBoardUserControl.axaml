<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels.Components"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="570"
             x:DataType="vm:RightBoardUserControlViewModel"
             Background="Black" 
             Opacity="0.8"
             x:Class="EquipmentLibraryV2_Avalonia.Views.Components.RightBoardUserControl">
    
    <UserControl.Styles>
        <StyleInclude Source="/Styles/RightBoardStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">        
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="0,0,0,1" Height="64">
            <StackPanel Spacing="10" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ELA V2" FontSize="15" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Image Source="{SvgImage /Assets/alpha.svg}" 
                       Width="40" Height="40"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Left" Margin="7,10,0,0">
            <ListBox ItemsSource="{Binding Buttons}" 
                     SelectedItem="{Binding SelectedButton}"
                     Background="Transparent" 
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashboardButtonViewModel">
                        <Grid ColumnDefinitions="Auto, *">
                            <Svg Grid.Column="0" Path="{Binding IconPath}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ButtonText}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" FontWeight="Medium"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="5">
            <StackPanel Spacing="8" HorizontalAlignment="Left" Margin="2,0,0,0">
               <Button Command="{Binding OpenProfileOrAuthorizationCommand}" Width="185" Height="40" Classes="BTN">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{SvgImage /Assets/user-round.svg}" Width="20" Height="20"/>
                        <TextBlock Text="Профиль" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" Width="185" Height="40" Classes="BTN">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{SvgImage /Assets/settings.svg}" Width="20" Height="20"/>
                        <TextBlock Text="Настройки" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
