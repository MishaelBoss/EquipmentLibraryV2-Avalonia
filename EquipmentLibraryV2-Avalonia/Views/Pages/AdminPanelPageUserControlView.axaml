<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels.Pages"
             xmlns:cvm="using:EquipmentLibraryV2_Avalonia.ViewModels.Components"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:AdminPanelPageUserControlViewModel"
             x:Class="EquipmentLibraryV2_Avalonia.Views.Pages.AdminPanelPageUserControlView">
	
	<UserControl.Styles>
		<StyleInclude Source="/Styles/UserCardStyles.axaml"/>
		<StyleInclude Source="/Styles/ModernStyles.axaml"/>
		<StyleInclude Source="/Styles/Styles.axaml"/>
	</UserControl.Styles>
	
	<Design.DataContext>
		<vm:AdminPanelPageUserControlViewModel/>
	</Design.DataContext>

	<Grid>
        <Grid Margin="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="#0F0F11"
                    BorderBrush="#2D2D30"
                    CornerRadius="8,8,0,0"
                    Height="42"
                    ClipToBounds="True">
                <ListBox SelectedIndex="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalAlignment="Stretch">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="24,0"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#9E9EB0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="#2D2D30"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Height" Value="42"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1A1A1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1E3A5F"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBoxItem Content="Пользователи"/>
                </ListBox>
            </Border>
				<Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto, *">
					<Grid Grid.Row="0">
						<Border CornerRadius="0,0,8,8"
						        Background="#1D1D1F"
						        BorderThickness="0"
						        Padding="16,8">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
								<StackPanel Grid.Column="0" Orientation="Horizontal"
								            HorizontalAlignment="Left" Spacing="15">
									<TextBox Width="280"
									         Height="38"
									         PlaceholderText="Search"
									         HorizontalAlignment="Left"
									         VerticalContentAlignment="Center"
									         Text="{Binding SearchText, Mode=TwoWay}"
									         Margin="0"
									         CornerRadius="14"
									         BorderThickness="1.5"
									         BorderBrush="#B0B3B8"
									         FontSize="15"/>
									<StackPanel Orientation="Horizontal" Spacing="10">
										<CheckBox Content="Активные" IsChecked="{Binding ShowActiveUsers}" Classes="WhiteOutline"/>
										<CheckBox Content="Неактивные" IsChecked="{Binding ShowInactiveUsers}" Classes="WhiteOutline"/>
									</StackPanel>
								</StackPanel>
								
								<Button  Grid.Row="0" Grid.Column="1" Height="38" Cursor="Hand" Padding="16,0"
								         Background="#2B2D31" Foreground="White" BorderBrush="#B0B3B8"
								         BorderThickness="1.5" CornerRadius="14"
								         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
								         Command="{Binding AddUserCommand}">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Image Source="{SvgImage /Assets/add_dark.svg}" 
										       Width="14" 
										       Height="14"
										       Svg.Css="path { stroke: #CED0D6; stroke-width: 1.5; stroke-linejoin: round; }"/>
										<TextBlock Text="Добавить" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
									</StackPanel>
								</Button>
							</Grid>
						</Border>
					</Grid>
					<Grid Grid.Row="2">
						<ScrollViewer Margin="10">
							<ItemsControl ItemsSource="{Binding UserList}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="cvm:CartUserViewModel">
										<Border Classes="UserCard">
											<Grid Margin="12" ColumnDefinitions="Auto, *, Auto">
												<Border Grid.Column="0"
														Width="42" Height="42"
														CornerRadius="21"
														Background="#28A745"
														VerticalAlignment="Center">
													<TextBlock Text="{Binding AvatarChar}" 
															   Foreground="White"
															   FontSize="18"
															   FontWeight="Bold"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center"/>
													</Border>

													<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
														<StackPanel Orientation="Horizontal" Spacing="8">
															<TextBlock Text="{Binding Login}" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
															<Border Background="#4A90E2" CornerRadius="4" Padding="4,1">
																<TextBlock Text="ADMIN" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontWeight="Black"/>
															</Border>
														</StackPanel>
	            
														<TextBlock Text="{Binding FirstName}" Foreground="#AAA" FontSize="12"/>
														<TextBlock Text="{Binding DateJoined, StringFormat='Joined: {0}'}" Foreground="#666" FontSize="11"/>
													</StackPanel>

													<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
														<ToggleButton IsChecked="{Binding IsActive}"
																	  Command="{Binding ChangeActiveUserCommand}"
																	  Classes="action isActive">
															<Panel>
																<Image Source="{SvgImage /Assets/toggle-right.svg}" Width="19" Height="19" IsVisible="{Binding IsActive}"/>
																<Image Source="{SvgImage /Assets/toggle-left.svg}" Width="19" Height="19" IsVisible="{Binding !IsActive}"/>
															</Panel>
														</ToggleButton>

														<Button Command="{Binding EditCommand}"
																Classes="action edit" Background="#34C759">
															<Image Source="{SvgImage /Assets/user-pen.svg}" Width="19" Height="19"/>
														</Button>

														<Button Command="{Binding DeleteCommand}"
																Classes="action delete" Background="#FF3B30">
															<Image Source="{SvgImage /Assets/trash.svg}" Width="19" Height="19"/>
														</Button>
														
														<Button Command="{Binding PasswordResetCommand}"
																Content="Выдать новый пароль" 
														        Classes="action passwordReset" 
														        MinWidth="60" Width="180" MaxWidth="200" 
														        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
													</StackPanel>
												</Grid>
											</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					
						<Grid Grid.Row="0" IsVisible="{Binding IsLoading}"
						      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
								<ProgressBar IsIndeterminate="True" Width="200" Height="6"/>
								<TextBlock Text="Загрузка..." Foreground="#888" FontSize="13" HorizontalAlignment="Center"/>
							</StackPanel>
						</Grid>
					</Grid>
				</Grid>
        </Grid>
    </Grid>
</UserControl>
