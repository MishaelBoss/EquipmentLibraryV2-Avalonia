<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels.Pages"
             x:DataType="vm:WorkAreaUserControlViewModel"
             x:Class="EquipmentLibraryV2_Avalonia.Views.Pages.WorkAreaUserControlView">
    
     <UserControl.Styles>
        <StyleInclude Source="/Styles/WorkAreaUserControlStyles.axaml"/>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" 
                Background="#0F0F11" 
                BorderBrush="#2D2D30" 
                CornerRadius="8,8,0,0"
                Height="42"
                ClipToBounds="True">
            
            <ListBox ItemsSource="{Binding EquipmentTypes}" 
                     SelectedItem="{Binding SelectedEquipmentType}"
                     Background="Transparent" 
                     BorderThickness="0"
                     Padding="0"
                     VerticalAlignment="Stretch">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="0"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="24,0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#9E9EB0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#2D2D30"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Height" Value="42"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#1A1A1C"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#1E3A5F"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                </ListBox.Styles>
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        
        <Grid Grid.Row="1" Margin="20">
            <Grid ColumnDefinitions="*, 300">
                <Border Grid.Column="0" 
                        Background="#151517" 
                        BorderBrush="#2D2D30" 
                        BorderThickness="1" 
                        CornerRadius="12"
                        Margin="0,0,16,0">
                    <Grid RowDefinitions="Auto, *, Auto" Margin="24">
                        
                        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
                            <TextBlock Text="{Binding SelectedEquipmentType, StringFormat='Быстрая регистрация: {0}'}" 
                                       Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Внесите параметры технического объекта в активную карточку реестра" 
                                       Foreground="#666" FontSize="12"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                        <TextBlock Text="Наименование" Foreground="#9E9EB0" FontSize="11"/>
                                        <TextBox Text="{Binding Title}" PlaceholderText="Введите название..." VerticalContentAlignment="Center" Height="36"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                        <TextBlock Text="Заводской номер" Foreground="#9E9EB0" FontSize="11"/>
                                        <TextBox Text="{Binding SerialNumber}" PlaceholderText="Заводской №" VerticalContentAlignment="Center" Height="36"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid ColumnDefinitions="*, *">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                        <TextBlock Text="Модель изделия" Foreground="#9E9EB0" FontSize="11"/>
                                        <TextBox Text="{Binding Model}" PlaceholderText="Укажите модель..." VerticalContentAlignment="Center" Height="36"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                        <TextBlock Text="Инвентарный номер" Foreground="#9E9EB0" FontSize="11"/>
                                        <TextBox Text="{Binding InvNumber}" PlaceholderText="Инвентарный №" VerticalContentAlignment="Center" Height="36"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" 
                                Content="Добавить объект в систему" 
                                Command="{Binding AddCommand}"
                                HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Height="40" 
                                Classes="Add"
                                Margin="0,24,0,0"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="12">
                    <Border Background="#151517" BorderBrush="#2D2D30" BorderThickness="1" Height="74" CornerRadius="8" BoxShadow="0 2 6 0 #20000000">
                        <Grid ColumnDefinitions="4, *">
                            <Border Background="#D32F2F" CornerRadius="8,0,0,8"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                <TextBlock Text="12" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="ПОВЕРКА ИСТЕКАЕТ (30 ДНЕЙ)" FontSize="10" FontWeight="Medium" Foreground="#D32F2F" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#151517" BorderBrush="#2D2D30" BorderThickness="1" Height="74" CornerRadius="8" BoxShadow="0 2 6 0 #20000000">
                        <Grid ColumnDefinitions="4, *">
                            <Border Background="#43A047" CornerRadius="8,0,0,8"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                <TextBlock Text="{Binding TotalObjects}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="ВСЕГО ОБЪЕКТОВ УЧЕТА" FontSize="10" FontWeight="Medium" Foreground="#43A047" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
