<Window xmlns="https://github.com/avaloniaui"
        xmlns:converters="using:EquipmentLibraryV2_Avalonia.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:EquipmentLibraryV2_Avalonia.Views.Components"
        xmlns:equipmentLibraryV2Avalonia="clr-namespace:EquipmentLibraryV2_Avalonia"
        xmlns:infrastructure="clr-namespace:EquipmentLibraryV2_Avalonia.Infrastructure"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
        Width="1000" Height="650" 
        MinWidth="900" MinHeight="640"
        x:Class="EquipmentLibraryV2_Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="#000000"
        Icon="/Assets/logo/logo.ico"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="Equipment Library V2">

	<Window.Styles>
		<StyleInclude Source="/Styles/Styles.axaml"/>
	</Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>

	<Border CornerRadius="8" Background="#000000" ClipToBounds="True" x:Name="MainBorder">
		<Grid RowDefinitions="Auto, *, Auto">
			<Grid Grid.Row="0" Grid.ColumnSpan="2" Height="40" ColumnDefinitions="*, Auto" ZIndex="20"
			      Background="Transparent"
			      WindowDecorationProperties.ElementRole="TitleBar">
				<Image Grid.Column="0" Source="/Assets/logo/logo.ico" Width="18" Height="18"
				       Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
				       IsHitTestVisible="False" IsVisible="{OnPlatform True, macOS=False}"/>
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Height="34" IsVisible="{OnPlatform True, macOS=False, Linux=False, Windows=True}">
					<Button Classes="WB"
					        WindowDecorationProperties.ElementRole="MinimizeButton"
					        Click="Minimize_Click">
						<Image Source="{SvgImage /Assets/windows/minimize_dark.svg}" Width="16" Height="16" IsHitTestVisible="False"/>
					</Button>
					<Button Classes="WB"
					        WindowDecorationProperties.ElementRole="MaximizeButton"
					        Click="MaximizeRestore_Click">
						<Grid IsHitTestVisible="False">
							<Image x:Name="MaximizeIcon" Source="{SvgImage /Assets/windows/maximize_dark.svg}" Width="16" Height="16"/>
							<Image x:Name="RestoreIcon" Source="{SvgImage /Assets/windows/restore_dark.svg}" Width="16" Height="16" IsVisible="False"/>
						</Grid>
					</Button>
					<Button Classes="WB CloseButton"
					        WindowDecorationProperties.ElementRole="CloseButton"
					        Click="Close_Click">
						<Panel IsHitTestVisible="False">
							<Image Classes="normal" Source="{SvgImage /Assets/windows/closeActive_dark.svg}" Width="16" Height="16"/>
							<Image Classes="hover" Source="{SvgImage /Assets/windows/closeHover.svg}" Width="16" Height="16"/>
						</Panel>
					</Button>
				</StackPanel>
			</Grid>

			<Grid Grid.Row="1" ColumnDefinitions="Auto, *">
				<Grid Grid.Column="0">
					<components:RightBoardUserControl DataContext="{Binding RightBoardViewModel}"/>
				</Grid>

				<Border Grid.Column="1"
						Background="#2B2D31"
						CornerRadius="8"
						Margin="8, 0, 8, 8"
						ClipToBounds="True">
					<Grid>
						<equipmentLibraryV2Avalonia:FadeContentControl Content="{Binding CurrentPage}" ZIndex="0"/>
						<ScrollViewer ZIndex="999" VerticalAlignment="Bottom" HorizontalAlignment="Right"
						              MaxHeight="300" Margin="12">
							<ItemsControl ItemsSource="{Binding ErrorMessages}"
							              VerticalAlignment="Bottom">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Spacing="8" VerticalAlignment="Bottom"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
							</ItemsControl>
						</ScrollViewer>
					</Grid>
				</Border>
			</Grid>

			<ContentControl Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
							Content="{Binding TopOverlayContent}"
							ZIndex="10"/>
			
			<Border Grid.Row="2" Grid.ColumnSpan="2"
			        Background="#000000"
			        Padding="16,0" Height="28">
				<Grid ColumnDefinitions="Auto, Auto, * ,Auto">
					<Grid Grid.Column="0">
						<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsConnected}">
							<Ellipse Width="8" Height="8" Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
							<TextBlock Text="{Binding StatusNetwork}" Foreground="#888" FontSize="11"/>
						</StackPanel>
						
						<Button Background="Transparent" Command="{Binding ReturnToConnectNetworkCommand}" IsVisible="{Binding !IsConnected}">
							<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
								<Ellipse Width="8" Height="8" Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
								<TextBlock Text="{Binding StatusNetwork}" Foreground="#888" FontSize="11"/>
								<Image Source="{SvgImage /Assets/refresh.svg}" Width="12" Height="12"/>
							</StackPanel>
						</Button>
					</Grid>
					
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0"
					            x:Name="RefreshIndicator" Opacity="0" IsVisible="False">
						<StackPanel.Transitions>
							<Transitions>
								<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
							</Transitions>
						</StackPanel.Transitions>
						<TextBlock Text="✓" Foreground="#4CAF50" FontSize="12" FontWeight="Bold"/>
						<TextBlock Text="Обновлено" Foreground="#4CAF50" FontSize="11"/>
					</StackPanel>
					
					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0"
					            IsVisible="{x:Static infrastructure:App.IsDeveloperMode}">
						<TextBlock Text="Вы находитесь в режиме dev" Foreground="#4CAF50" FontSize="11"/>
					</StackPanel>
					
					<Grid Grid.Column="3">
						<Button Background="Transparent" Command="{Binding VersionActionCommand}">
							<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
								<Image Source="{SvgImage /Assets/update.svg}" Width="12" Height="12" IsVisible="{Binding IsNewVersion}"/>
								<TextBlock VerticalAlignment="Center" Foreground="#666" FontSize="11" FontWeight="SemiBold" Text="{Binding Version}"/>
							</StackPanel>
						</Button>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Border>
</Window>
