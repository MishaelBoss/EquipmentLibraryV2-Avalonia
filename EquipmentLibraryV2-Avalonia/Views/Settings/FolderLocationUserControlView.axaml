<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels.Settings"
             x:DataType="vm:FolderLocationUserControlViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="EquipmentLibraryV2_Avalonia.Views.Settings.FolderLocationUserControlView">
    <UserControl.Styles>
        <StyleInclude Source="/Styles/SettingsStyles.axaml"/>
    </UserControl.Styles>
    
    <StackPanel Spacing="20">
        <TextBlock Text="Настройка путей сохранения документов. Вы можете изменить расположение директории, в которую экспортируются и скачиваются файлы отчетов и спецификаций оборудования." 
                   Foreground="#9E9EB0" 
                   FontSize="13" 
                   TextWrapping="Wrap"/>
        
        <Border BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8" Padding="16" Background="#151517"
                BoxShadow="0 2 8 0 #30000000">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="20" Background="#1E3A5F" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="{SvgImage /Assets/informationDialog.svg}" Width="28" Height="28"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Сохранять файлы в корень папки напрямую"
                               FontSize="14" FontWeight="Medium" Foreground="White"/>
                    <TextBlock Text="Приложении не будет автоматически создавать подпапки проекта в выбранной директории"
                               Foreground="#777778" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <CheckBox Grid.Column="2"
                          IsChecked="{Binding UseRawSelectedFolder}"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"/>
            </Grid>
        </Border>
        
        <Border BorderBrush="#2D2D30" 
                BorderThickness="1" 
                CornerRadius="8" 
                Background="#151517"
                ClipToBounds="True">
            <StackPanel>
                
                <Grid ColumnDefinitions="*, Auto" Margin="16" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Расположение сохраненных документов" FontSize="14" FontWeight="Medium" Foreground="White"/>
                        <TextBlock Text="Открыть целевую папку в проводнике приложений" Foreground="#777778" FontSize="12"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1"
                            Classes="Btn1"
                            Command="{Binding OpenDownloadFolderCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="{SvgImage /Assets/folder-open.svg}" Width="14" Height="14"/>
                            <TextBlock Text="Открыть папку" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Background="#0F0F11" 
                        BorderBrush="#2D2D30" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8,8" 
                        Padding="16,10">
                    <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding FolderText}" 
                                   Foreground="#9E9EB0" 
                                   FontSize="13"
                                   FontFamily="Consolas, Inter, monospace"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        
                        <Button Grid.Column="1"
                                Classes="Btn1"
                                Command="{Binding SelectFolderCommand}"
                                Padding="12,6"
                                FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Image Source="{SvgImage /Assets/edit_dark.svg}" Width="12" Height="12"/>
                                <TextBlock Text="Изменить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
