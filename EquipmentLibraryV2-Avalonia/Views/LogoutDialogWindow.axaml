<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EquipmentLibraryV2_Avalonia.ViewModels"
        mc:Ignorable="d" 
        Width="400" Height="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="#1E1E24"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        x:Class="EquipmentLibraryV2_Avalonia.Views.LogoutDialogWindow"
        x:DataType="vm:LogoutDialogWindowViewModel"
        CornerRadius="8"
        BorderBrush="#2D2D35"
        BorderThickness="1"
        Title="">
    
    <Window.Styles>
        <StyleInclude Source="/Styles/Styles.axaml"/>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" 
                Height="38" 
                Padding="0"
                Background="Transparent"
                BorderBrush="#26262B" 
                BorderThickness="0,0,0,1"
                ZIndex="20"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="5">
                    <Image Source="/Assets/logo/logo.ico" Width="18" Height="18" IsVisible="{OnPlatform True, macOS=False}"/>
                    <TextBlock Text="logout"
                               FontWeight="SemiBold"
                               Foreground="#CED0D6"
                               IsHitTestVisible="False"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Height="34">
                    <Button x:Name="MinimizeButton" Classes="WB" WindowDecorationProperties.ElementRole="MinimizeButton">
                        <Image Source="{SvgImage /Assets/windows/minimize_dark.svg}" Width="16" Height="16" IsHitTestVisible="False"/>
                    </Button>
                    <Button x:Name="CloseButton" Classes="WB CloseButton" WindowDecorationProperties.ElementRole="CloseButton">
                        <Panel IsHitTestVisible="False">
                            <Image Classes="normal" Source="{SvgImage /Assets/windows/closeActive_dark.svg}" Width="16" Height="16"/>
                            <Image Classes="hover" Source="{SvgImage /Assets/windows/closeHover.svg}" Width="16" Height="16"/>
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="*, Auto" Margin="24">
            
            <StackPanel Grid.Row="0" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Выход из профиля" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="Вы уверены, что хотите выйти из учетной записи?" 
                           Foreground="#9E9EB0" 
                           FontSize="14" 
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Spacing="12" 
                        Margin="0,16,0,0">
                
                <Button Content="Отмена" 
                        Name="CancelButton"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Background="Transparent" 
                        Foreground="#9E9EB0" 
                        BorderBrush="#3D3D45"
                        BorderThickness="1"
                        Padding="20,8"
                        CornerRadius="6">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#2D2D35"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Button.Styles>
                </Button>

                <Button Content="Выйти" 
                        Name="LogoutButton"
                        Command="{Binding LogoutCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Background="#E05252" 
                        Foreground="White" 
                        Padding="24,8"
                        CornerRadius="6"
                        FontWeight="Medium">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#C84141"/>
                        </Style>
                    </Button.Styles>
                </Button>
                
            </StackPanel>
        </Grid>
    </Grid>
</Window>
