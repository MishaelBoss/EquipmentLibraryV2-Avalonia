# Copy to .env for local DEBUG runs only. Never commit .env.
# DEBUG builds search for .env upward from the working directory.
# RELEASE builds ignore .env and read these variables from the OS environment.
#
# The desktop app only connects to an existing database.
# Schema and the first administrator are created by EquipmentLibraryV2-Server
# (migrator + deploy), not by this app.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ELA_V2

# Runtime role: least privilege, no superuser/DDL rights.
DB_USER=ela_app
DB_PASSWORD=change-me

# Prefer, Require, VerifyCA, VerifyFull, Disable
# Use VerifyFull for remote PostgreSQL servers.
DB_SSL_MODE=Prefer
